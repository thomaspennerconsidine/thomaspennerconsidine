{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thomaspennerconsidine/thomaspennerconsidine/blob/main/config/profile.schema.json",
  "title": "GitHub profile content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "name",
    "tagline",
    "introduction",
    "specializations",
    "collaboration",
    "philosophy"
  ],
  "properties": {
    "$schema": {
      "const": "./profile.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "name": {
      "$ref": "#/$defs/nonempty"
    },
    "tagline": {
      "$ref": "#/$defs/nonempty"
    },
    "introduction": {
      "$ref": "#/$defs/paragraphs"
    },
    "specializations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/nonempty"
          },
          "description": {
            "$ref": "#/$defs/nonempty"
          }
        }
      }
    },
    "collaboration": {
      "$ref": "#/$defs/paragraphs"
    },
    "philosophy": {
      "$ref": "#/$defs/paragraphs"
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonempty"
      }
    }
  }
}
